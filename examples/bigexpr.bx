// Deeply nested expressions: the lowering needs many temporaries
def main() {
  var x = 12345 : int;
  var y = 678 : int;

  // a left-nested expression
  print(
    ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((x - 8) * 15)
    & 22) | 29) ^ 36) + 43) - 50) * 57) & 64) | 71) ^ 78) + 85) - 92) * 99)
    & 6) | 13) ^ 20) + 27) - 34) * 41) & 48) | 55) ^ 62) + 69) - 76) * 83) &
    90) | 97) ^ 4) + 11) - 18) * 25) & 32) | 39) ^ 46) + 53) - 60) * 67) &
    74) | 81) ^ 88) + 95) - 2) * 9) & 16) | 23) ^ 30) + 37) - 44) * 51) &
    58) | 65) ^ 72) + 79) - 86) * 93) & 100) | 7) ^ 14) + 21)
  );

  // a right-nested expression
  print(
    (31 - (28 + (25 ^ (22 | (19 & (16 * (13 - (10 + (7 ^ (4 | (1 & (48 * (45
    - (42 + (39 ^ (36 | (33 & (30 * (27 - (24 + (21 ^ (18 | (15 & (12 * (9 -
    (6 + (3 ^ (50 | (47 & (44 * (41 - (38 + (35 ^ (32 | (29 & (26 * (23 -
    (20 + (17 ^ (14 | (11 & (8 * (5 - (2 + (49 ^ (46 | (43 & (40 * (37 - (34
    + (31 ^ (28 | (25 & (22 * (19 - (16 + (13 ^ (10 | (7 & (4 *
    y))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
  );

  // a balanced expression tree of depth 6
  print(
    ((((((y & 1) + (x | y)) ^ ((4 ^ x) - (y + 7))) * (((x - y) * (10 * x)) +
    ((y & 13) & (x | y)))) - ((((3 ^ x) | (y + 6)) - ((x - y) ^ (9 * x))) &
    (((y & 12) + (x | y)) * ((2 ^ x) - (y + 5))))) - (((((x - y) * (8 * x))
    & ((y & 11) & (x | y))) | (((1 ^ x) | (y + 4)) | ((x - y) ^ (7 * x)))) *
    ((((y & 10) + (x | y)) ^ ((13 ^ x) - (y + 3))) ^ (((x - y) * (6 * x)) +
    ((y & 9) & (x | y))))))
  );
}
