// if / else if chains: the first condition that holds wins
def main() {
  var x = 1 : int;
  while (x <= 12) {
    if (x % 2 == 0) {
      print(2);
    } else if (x % 3 == 0) {
      print(3);
    } else if (x % 5 == 0) {
      print(5);
    } else if (x % 7 == 0) {
      print(7);
    } else if (x % 11 == 0) {
      print(11);
    } // no else
    x = x + 1;
  }
}
