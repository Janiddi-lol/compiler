// p(x) = 3x^4 - 2x^3 + 5x^2 - x + 7, evaluated with Horner's scheme,
// unrolled by hand for x = 1, ..., 5
def main() {
  var x = 0 : int;
  var acc = 0 : int;

  x = 1;
  acc = 3;
  acc = acc * x - 2;
  acc = acc * x + 5;
  acc = acc * x - 1;
  acc = acc * x + 7;
  print(acc);

  x = 2;
  acc = 3;
  acc = acc * x - 2;
  acc = acc * x + 5;
  acc = acc * x - 1;
  acc = acc * x + 7;
  print(acc);

  x = 3;
  acc = 3;
  acc = acc * x - 2;
  acc = acc * x + 5;
  acc = acc * x - 1;
  acc = acc * x + 7;
  print(acc);

  x = 4;
  acc = 3;
  acc = acc * x - 2;
  acc = acc * x + 5;
  acc = acc * x - 1;
  acc = acc * x + 7;
  print(acc);

  x = 5;
  acc = 3;
  acc = acc * x - 2;
  acc = acc * x + 5;
  acc = acc * x - 1;
  acc = acc * x + 7;
  print(acc);

  // the same, as single expressions
  print(3 * x * x * x * x - 2 * x * x * x + 5 * x * x - x + 7);
  print((((3 * x - 2) * x + 5) * x - 1) * x + 7);
}
