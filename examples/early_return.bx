// return from the middle of loops, in subroutines and functions

def find(target : int) : int {
  var i = 0 : int;
  while (i < 100) {
    var j = 0 : int;
    while (j < 100) {
      if (i * j == target) { return i * 1000 + j; }
      j = j + 1;
    }
    i = i + 1;
  }
  return 0 - 1;
}

def countdown(n : int) {
  while (true) {
    if (n <= 0) { return; }
    print(n);
    n = n - 1;
  }
}

def main() {
  print(find(42));
  print(find(97));
  print(find(1000));
  countdown(3);
  countdown(0);
}
