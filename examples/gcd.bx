// greatest common divisor, recursive and iterative

def gcd(a, b : int) : int {
  if (b == 0) { return a; }
  return gcd(b, a % b);
}

def gcd2(a, b : int) : int {
  while (b != 0) {
    var t = b : int;
    b = a % b;
    a = t;
  }
  return a;
}

def main() {
  print(gcd(1071, 462));
  print(gcd2(1071, 462));
  print(gcd(17, 5));
  print(gcd2(0, 9));
}
