// Many variables and chained updates: many copies in the TAC
def main() {
  var v0 = 0 : int;
  var v1 = 1 : int;
  var v2 = 2 : int;
  var v3 = 3 : int;
  var v4 = 4 : int;
  var v5 = 5 : int;
  var v6 = 6 : int;
  var v7 = 7 : int;
  var v8 = 8 : int;
  var v9 = 9 : int;
  var v10 = 10 : int;
  var v11 = 11 : int;
  var v12 = 12 : int;
  var v13 = 13 : int;
  var v14 = 14 : int;
  var v15 = 15 : int;
  var v16 = 16 : int;
  var v17 = 17 : int;
  var v18 = 18 : int;
  var v19 = 19 : int;
  var v20 = 20 : int;
  var v21 = 21 : int;
  var v22 = 22 : int;
  var v23 = 23 : int;
  var v24 = 24 : int;
  var v25 = 25 : int;
  var v26 = 26 : int;
  var v27 = 27 : int;
  var v28 = 28 : int;
  var v29 = 29 : int;
  var v30 = 30 : int;
  var v31 = 31 : int;
  var v32 = 32 : int;
  var v33 = 33 : int;
  var v34 = 34 : int;
  var v35 = 35 : int;
  var v36 = 36 : int;
  var v37 = 37 : int;
  var v38 = 38 : int;
  var v39 = 39 : int;

  // prefix sums
  v1 = v0 + v1;
  v2 = v1 + v2;
  v3 = v2 + v3;
  v4 = v3 + v4;
  v5 = v4 + v5;
  v6 = v5 + v6;
  v7 = v6 + v7;
  v8 = v7 + v8;
  v9 = v8 + v9;
  v10 = v9 + v10;
  v11 = v10 + v11;
  v12 = v11 + v12;
  v13 = v12 + v13;
  v14 = v13 + v14;
  v15 = v14 + v15;
  v16 = v15 + v16;
  v17 = v16 + v17;
  v18 = v17 + v18;
  v19 = v18 + v19;
  v20 = v19 + v20;
  v21 = v20 + v21;
  v22 = v21 + v22;
  v23 = v22 + v23;
  v24 = v23 + v24;
  v25 = v24 + v25;
  v26 = v25 + v26;
  v27 = v26 + v27;
  v28 = v27 + v28;
  v29 = v28 + v29;
  v30 = v29 + v30;
  v31 = v30 + v31;
  v32 = v31 + v32;
  v33 = v32 + v33;
  v34 = v33 + v34;
  v35 = v34 + v35;
  v36 = v35 + v36;
  v37 = v36 + v37;
  v38 = v37 + v38;
  v39 = v38 + v39;

  // rotate the values one step to the right, with a temporary
  var tmp = 0 : int;
  tmp = v39;
  v39 = v38;
  v38 = v37;
  v37 = v36;
  v36 = v35;
  v35 = v34;
  v34 = v33;
  v33 = v32;
  v32 = v31;
  v31 = v30;
  v30 = v29;
  v29 = v28;
  v28 = v27;
  v27 = v26;
  v26 = v25;
  v25 = v24;
  v24 = v23;
  v23 = v22;
  v22 = v21;
  v21 = v20;
  v20 = v19;
  v19 = v18;
  v18 = v17;
  v17 = v16;
  v16 = v15;
  v15 = v14;
  v14 = v13;
  v13 = v12;
  v12 = v11;
  v11 = v10;
  v10 = v9;
  v9 = v8;
  v8 = v7;
  v7 = v6;
  v6 = v5;
  v5 = v4;
  v4 = v3;
  v3 = v2;
  v2 = v1;
  v1 = v0;
  v0 = tmp;

  print(v0);
  print(v5);
  print(v10);
  print(v15);
  print(v20);
  print(v25);
  print(v30);
  print(v35);
  print(v39);
}
