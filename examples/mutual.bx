// mutual recursion, boolean functions used in conditions

def is_even(n : int) : bool {
  if (n == 0) { return true; }
  return is_odd(n - 1);
}

def is_odd(n : int) : bool {
  if (n == 0) { return false; }
  return is_even(n - 1);
}

def main() {
  var n = 0 : int;
  while (n < 6) {
    if (is_even(n)) { print(n); }
    if (is_odd(n) && n > 2) { print(0 - n); }
    print(is_even(n) || is_odd(n));
    n = n + 1;
  }
}
